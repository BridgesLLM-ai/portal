{
  "name": "bridgesllm-backend",
  "version": "5.1.0",
  "description": "BridgesLLM Portal Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=tsconfig.json --watch-path=package.json --watch-preserve-output -r ts-node/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv run --quiet -- prisma migrate dev",
    "prisma:studio": "dotenv run --quiet -- prisma studio",
    "test": "jest",
    "test:dev-watch": "node scripts/test-dev-watch.cjs",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/archiver": "8.0.0",
    "@types/express-session": "^1.19.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "archiver": "8.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bowser": "^2.14.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "httpxy": "^0.5.5",
    "js-yaml": "5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "nanoid": "6.0.2",
    "node-cron": "^4.6.0",
    "node-pty": "^1.0.0",
    "nodemailer": "^10.1.7",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "systeminformation": "^5.33.16",
    "winston": "^3.11.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@img/sharp-wasm32": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/sanitize-html": "^2.16.2",
    "@types/yauzl": "3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "babel-plugin-istanbul": {
      "test-exclude": "8.0.0"
    },
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.6",
    "qs": "6.16.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "license": "MIT"
}
